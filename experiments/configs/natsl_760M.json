{
    "name": "Neural Attention Search 760M",
    "attn_mode": "chunk",
    "bos_token_id": 1,
    "conv_size": 4,
    "eos_token_id": 2,
    "expand_v": 2,
    "fuse_cross_entropy": false,
    "head_dim": 192,
    "hidden_act": "swish",
    "hidden_ratio": 4,
    "hidden_size": 1536,
    "initializer_range": 0.02,
    "intermediate_size": null,
    "model_type": "neural_attention_search_linear_attn_gdn",
    "norm_eps": 1e-06,
    "num_heads": 6,
    "num_attn_heads": 18,
    "num_hidden_layers": 21,
    "n_ops": 2,
    "nats_block_size": 64,
    "compute_dnats_for_invalid_blocks_linear_att":false,
    "compute_dnats_for_invalid_blocks_att":false,
    "ops_for_incomplete_chunks": "all",
    "tie_word_embeddings": false,
    "attn_qk_norm":true,
    "attn_with_short_conv":true,
    "use_cache": true,
    "use_gate": true,
    "use_short_conv": true,
    "gdn_layers": [0,1,2, 4,5,6, 8,9,10, 12,13,14, 16,17,18],
    "attn_apply_pos_encoding": false,
    "decay_for_non_gdn_blocks": true
}

